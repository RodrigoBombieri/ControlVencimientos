## Visual Studio / .NET Core / Razor Pages - .gitignore
## Generated for Visual Studio 2026 and .NET 10 Razor Pages project

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache and workspace
.vs/
.vscode/
.idea/

# Build results
*/publish/
**/publish/

# Rider
.idea/
*.sln.iml

# NuGet
.nuget/packages/
packages/
*.nupkg

# MSBuild generated files
project.lock.json
project.fragment.lock.json
artifacts/

# Backup & temporary files
~$*
*.tmp
*.temp
*.log
*.log.*

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# DotCover
.dotCover

# Coverage & profiling
coverage/
coverage.*

# SQL Server files
*.mdf
*.ldf

# User secrets and local configuration
secrets.json
appsettings.*.Development.json
appsettings.*.Local
.env
.env.*

# Web dependencies
node_modules/
jspm_packages/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Static web publish folder
wwwroot/lib/

# JetBrains Rider caches
.idea/
/.idea/

# ReSharper
_ReSharper*/
*.DotSettings.user

# VS Code
.history/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# GitHub Actions and CI artifacts
.publish
/.cache

# Ensure the solution file and source code are tracked
!/*.sln
!/*.slnx
!/**/*.cs
!/**/*.cshtml
!/**/*.csproj
