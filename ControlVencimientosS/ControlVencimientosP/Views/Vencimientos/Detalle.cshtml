@model ControlVencimientosP.ViewModels.DetalleVencimientoViewModel
@{
    ViewData["Title"] = Model.ItemNombre;
}

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="cv-flash">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        <div>@mensaje</div>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="cv-form-errors">@error</div>
}

<h1 class="cv-page-title">@Model.ItemNombre</h1>
<p class="cv-page-sub">@Model.CategoriaNombre@(Model.ItemCodigo is null ? "" : $" · {Model.ItemCodigo}")</p>

<div class="cv-card">
    <div class="cv-card-head">
        <div class="cv-card-title">Vencimiento</div>
        <div class="cv-spacer"></div>
        <partial name="_BadgeEstado" model="Model.EstadoSemaforo" />
    </div>

    <div class="cv-details-grid">
        <div>
            <span class="cv-details-label">Vence el</span>
            <span class="cv-details-value">@Model.FechaVencimiento.ToString("dd/MM/yyyy") (@PresentacionSemaforo.Relativo(Model.DiasRestantes))</span>
        </div>
        @if (Model.FechaEmision is not null)
        {
            <div>
                <span class="cv-details-label">Emitido el</span>
                <span class="cv-details-value">@Model.FechaEmision.Value.ToString("dd/MM/yyyy")</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.NumeroDocumento))
        {
            <div>
                <span class="cv-details-label">N° de documento</span>
                <span class="cv-details-value">@Model.NumeroDocumento</span>
            </div>
        }
        @if (Model.Monto is not null)
        {
            <div>
                <span class="cv-details-label">Monto</span>
                <span class="cv-details-value">@Model.Monto.Value.ToString("N2")@(string.IsNullOrEmpty(Model.Moneda) ? "" : $" {Model.Moneda}")</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ItemUbicacion))
        {
            <div>
                <span class="cv-details-label">Ubicación</span>
                <span class="cv-details-value">@Model.ItemUbicacion</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ItemProveedor))
        {
            <div>
                <span class="cv-details-label">Proveedor</span>
                <span class="cv-details-value">@Model.ItemProveedor</span>
            </div>
        }
        <div>
            <span class="cv-details-label">Cargado el</span>
            <span class="cv-details-value">@Model.CreadoEn.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    @if (Model.Estado == EstadoVencimiento.Activo)
    {
        <div class="cv-form-actions">
            <form asp-action="Anular" asp-route-id="@Model.VencimientoId" method="post" class="cv-inline-form"
                  onsubmit="return confirm('¿Anular este vencimiento? No se puede deshacer.');">
                <button type="submit" class="cv-btn-ghost">Anular</button>
            </form>
            <a class="cv-btn-ghost" asp-action="Editar" asp-route-id="@Model.VencimientoId">Editar</a>
            <a class="cv-btn-primary" asp-action="Renovar" asp-route-id="@Model.VencimientoId">Renovar</a>
        </div>
    }
    else
    {
        <p class="cv-hint" style="padding: 0 18px 18px;">
            Este vencimiento está @(Model.Estado == EstadoVencimiento.Anulado ? "anulado" : "renovado") y no admite cambios.
            @if (Model.Estado == EstadoVencimiento.Renovado && Model.RenovadoPorVencimientoId is not null)
            {
                <a asp-action="Detalle" asp-route-id="@Model.RenovadoPorVencimientoId">Ver la renovación →</a>
            }
        </p>
    }
</div>

<div class="cv-card">
    <div class="cv-card-head">
        <div class="cv-card-title">Adjuntos</div>
    </div>
    <div class="cv-card-body">
        @if (Model.Adjuntos.Count == 0)
        {
            <div class="cv-empty">No hay archivos adjuntos todavía.</div>
        }
        else
        {
            <ul class="cv-adjuntos-list">
                @foreach (var adjunto in Model.Adjuntos)
                {
                    <li>
                        <a asp-action="DescargarAdjunto" asp-route-id="@adjunto.Id">@adjunto.NombreArchivo</a>
                        <span class="cv-hint">(@((adjunto.TamanioBytes / 1024.0).ToString("N0")) KB)</span>
                        <form asp-action="EliminarAdjunto" asp-route-id="@adjunto.Id" method="post" class="cv-inline-form"
                              onsubmit="return confirm('¿Eliminar este adjunto?');">
                            <button type="submit" class="cv-adjunto-eliminar">Eliminar</button>
                        </form>
                    </li>
                }
            </ul>
        }

        <form asp-action="SubirAdjunto" asp-route-id="@Model.VencimientoId" method="post" enctype="multipart/form-data" class="cv-upload-form">
            @Html.AntiForgeryToken()
            <input type="file" name="archivo" accept=".pdf,.jpg,.jpeg,.png" required />
            <button type="submit" class="cv-btn-ghost">Subir</button>
        </form>
        <p class="cv-hint">PDF, JPG o PNG, hasta 10&nbsp;MB.</p>
    </div>
</div>
