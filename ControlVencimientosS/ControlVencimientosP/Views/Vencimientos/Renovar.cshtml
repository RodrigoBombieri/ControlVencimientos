@model ControlVencimientosP.ViewModels.RenovarVencimientoViewModel
@{
    ViewData["Title"] = "Renovar vencimiento";
}

<h1 class="cv-page-title">Renovar vencimiento</h1>
<p class="cv-page-sub">@Model.ItemNombre@(Model.ItemCodigo is null ? "" : $" · {Model.ItemCodigo}") · @Model.CategoriaNombre</p>

<div class="cv-form-card">
    <form asp-controller="Vencimientos" asp-action="Renovar" asp-route-id="@Model.VencimientoId" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="cv-form-errors"></div>

        <p class="cv-hint">
            Vencía el @Model.FechaVencimientoAnterior.ToString("dd/MM/yyyy"). Esto crea un vencimiento
            nuevo y deja el actual como historial — a diferencia de Editar, que corrige el mismo registro.
        </p>

        <div class="cv-field">
            <label asp-for="FechaVencimiento">Vence el</label>
            <input asp-for="FechaVencimiento" type="date" autofocus />
            <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
        </div>

        <div class="cv-field">
            <label asp-for="Monto">Monto</label>
            <input asp-for="Monto" type="number" step="0.01" min="0" placeholder="0,00" />
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>

        <div class="cv-form-actions">
            <a class="cv-btn-ghost" asp-action="Detalle" asp-route-id="@Model.VencimientoId">Cancelar</a>
            <button type="submit" class="cv-btn-primary">Renovar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
